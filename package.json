{
  "name": "rexiano",
  "version": "2.1.0",
  "description": "A free, open-source piano practice web app and Synthesia alternative",
  "author": "Rexiano Contributors",
  "license": "GPL-3.0",
  "homepage": "https://github.com/EndeavorYen/Rexiano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EndeavorYen/Rexiano.git"
  },
  "bugs": {
    "url": "https://github.com/EndeavorYen/Rexiano/issues"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:visual": "playwright test e2e/ui-polish.spec.ts e2e/sheet-music-visual-fixtures.spec.ts e2e/accessibility-core.spec.ts",
    "test:visual:update": "playwright test e2e/ui-polish.spec.ts e2e/sheet-music-visual-fixtures.spec.ts e2e/accessibility-core.spec.ts --update-snapshots",
    "generate:songs": "jiti scripts/generate-songs.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "site:assets": "node site/scripts/sync-assets.mjs",
    "site:dev": "pnpm site:assets && vite --config site/vite.config.ts --host 127.0.0.1",
    "site:build": "pnpm site:assets && vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts --host 127.0.0.1",
    "site:typecheck": "tsc --noEmit -p site/tsconfig.json",
    "preview": "vite preview",
    "build:e2e": "cross-env VITE_REXIANO_E2E=1 vite build --outDir dist-e2e",
    "changelog": "node scripts/build-changelog.mjs"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jiti": "^2.6.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.8.15",
      "brace-expansion@^1": "1.1.21",
      "brace-expansion@^5": "5.0.12",
      "browserslist": "4.29.3",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.8",
      "flatted": "3.4.2",
      "form-data": "4.0.6",
      "ip-address": "10.7.2",
      "js-yaml": "4.3.2",
      "lodash": "4.18.1",
      "nanoid": "3.3.19",
      "picomatch": "4.0.4",
      "postcss": "8.5.28",
      "tar": "7.5.22",
      "tmp": "0.2.7"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.1",
    "@tonejs/midi": "^2.0.28",
    "lucide-react": "^0.575.0",
    "midi-file": "^1.2.4",
    "pixi.js": "^8.16.0",
    "soundfont2": "^0.5.0",
    "vexflow": "^5.0.0",
    "zustand": "^5.0.11"
  }
}
